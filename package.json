{
  "name": "docchat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run \"/^dev(:worker)?$/\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test:integration": "pnpm --filter @docchat/api test:integration",
    "eval:retrieval": "pnpm --filter @docchat/api eval:retrieval"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
